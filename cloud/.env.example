# Generate a long random token locally. Never commit the real token.
KATAGO_API_TOKEN=replace-with-a-long-random-secret

# Optional public HTTPS endpoint. DNS A/AAAA records must point to the host.
CADDY_DOMAIN=go.example.net

# Optional Cloudflare Tunnel token. Keep the real value only in your local .env.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
